MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5a05b93a15d59a04cb9746ed1bba5d9f, type: 3}
  m_Name: Narrador
  m_EditorClassIdentifier: 
  dialogueLines:
  - characterName: Narrador
    text: "Sense resposta, sense veu, sense lloc\u2026 Cleo fou exiliada del regne
      que havia estat casa seva. "
    voiceClip: {fileID: 8300000, guid: bea70755ade971d42a6953120688db44, type: 3}
    displayTime: 8
    textColor: {r: 1, g: 1, b: 1, a: 1}
  - characterName: Narrador
    text: "I aix\xED, sense entendre el perqu\xE8, Cleo va comen\xE7ar a caminar.
      No sab\xEDa on m\xE9s anar. Nom\xE9s quedava un lloc: la casa de Sant Jordi. "
    voiceClip: {fileID: 8300000, guid: b8a697524bee7894298f8f60e1350097, type: 3}
    displayTime: 11
    textColor: {r: 1, g: 1, b: 1, a: 1}
  - characterName: Narrador
    text: "Perqu\xE8, a vegades, quan tot cau, l\u2019\xFAnic que pots fer\u2026
      \xE9s caminar cap on encara et queda una mica de veritat. "
    voiceClip: {fileID: 8300000, guid: 2819c41b043d0554b858d5886e1bd70c, type: 3}
    displayTime: 7
    textColor: {r: 1, g: 1, b: 1, a: 1}
